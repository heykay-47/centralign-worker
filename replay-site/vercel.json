{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/files/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
