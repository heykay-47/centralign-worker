OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
WORKER_COMPANY_URL=http://127.0.0.1:3000/company
WORKER_MAX_STEPS=25
WORKER_STEP_TIMEOUT_MS=90000
DATA_DIR=.data
